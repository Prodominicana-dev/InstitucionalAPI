# ========================================
# RELAY SMTP DE SALIDA
# ========================================
# Sin estas variables se usa el relay interno de siempre: 10.25.1.68:587
# sin TLS y sin credenciales. Solo hay que definirlas para apuntar a otro
# servidor de correo.

MAIL_HOST=10.25.1.68
MAIL_PORT=587

# true = conexion cifrada (puerto 465). Cualquier otro valor deja la conexion
# en claro con ignoreTLS, que es como estaba.
MAIL_SECURE=false

# Solo si el relay pide usuario y contrasena. Si MAIL_USER esta vacio no se
# manda ninguna credencial.
MAIL_USER=
MAIL_PASSWORD=
