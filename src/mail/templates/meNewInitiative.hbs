<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Nueva iniciativa en Mujer Exporta+</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office">
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <style>
    td,th,div,p,a,h1,h2,h3,h4,h5,h6 {font-family: "Segoe UI", sans-serif; mso-line-height-rule: exactly;}
  </style>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; width: 100%; background-color: #FDF8F7; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #FDF8F7;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">

          <!-- Header -->
          <tr>
            <td style="background-color: #ffffff; padding: 30px 40px; text-align: center; border-bottom: 4px solid #F2665E;">
              <img src="https://prodominicana.gob.do/mujer-exporta/logo.png" alt="Mujer Exporta+" width="200" style="max-width: 200px; height: auto;">
            </td>
          </tr>

          <!-- Badge de nueva iniciativa -->
          <tr>
            <td style="padding: 30px 40px 0; text-align: center;">
              <span style="display: inline-block; background-color: #d5f1f4; color: #2FB7C8; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 8px 16px; border-radius: 20px;">
                Nueva iniciativa disponible
              </span>
            </td>
          </tr>

          <!-- Contenido principal -->
          <tr>
            <td style="padding: 25px 40px 40px;">
              <p style="color: #1A365D; font-size: 16px; line-height: 1.6; margin: 0 0 20px;">
                Hola <strong>{{subscriberName}}</strong>,
              </p>

              <p style="color: #4A5568; font-size: 16px; line-height: 1.7; margin: 0 0 25px;">
                Tenemos una nueva oportunidad para ti en <strong style="color: #F2665E;">Mujer Exporta+</strong>:
              </p>

              <!-- Tarjeta de la iniciativa -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F7FAFC; border-radius: 12px; overflow: hidden; margin-bottom: 25px;">
                <!-- Barra de color de ruta -->
                <tr>
                  <td style="height: 6px; background-color: {{rutaColor}};"></td>
                </tr>
                <tr>
                  <td style="padding: 25px;">
                    <!-- Badges -->
                    <table role="presentation" cellpadding="0" cellspacing="0" style="margin-bottom: 15px;">
                      <tr>
                        <td style="padding-right: 10px;">
                          <span style="display: inline-block; background-color: {{rutaLightColor}}; color: {{rutaColor}}; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 15px;">
                            {{ruta}}
                          </span>
                        </td>
                        <td>
                          <span style="display: inline-block; background-color: #EDF2F7; color: #4A5568; font-size: 12px; font-weight: 500; padding: 6px 12px; border-radius: 15px;">
                            {{tipo}}
                          </span>
                        </td>
                      </tr>
                    </table>

                    <!-- Título -->
                    <h2 style="color: #1A365D; font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0 0 12px;">
                      {{title}}
                    </h2>

                    <!-- Descripción -->
                    <p style="color: #4A5568; font-size: 14px; line-height: 1.6; margin: 0 0 15px;">
                      {{description}}
                    </p>

                    <!-- Autor -->
                    <p style="color: #718096; font-size: 13px; margin: 0;">
                      <strong>Ofrecido por:</strong> {{autor}}
                    </p>

                    {{#if endDate}}
                    <p style="color: #E53E3E; font-size: 13px; margin: 10px 0 0; font-weight: 500;">
                      Disponible hasta: {{endDate}}
                    </p>
                    {{/if}}
                  </td>
                </tr>
              </table>

              <!-- CTA Button -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding: 5px 0 30px;">
                    <a href="{{initiativeUrl}}" style="display: inline-block; background-color: #F2665E; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; padding: 16px 40px; border-radius: 12px;">
                      Ver iniciativa
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Explorar más -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #FDF8F7; border-radius: 12px; padding: 20px;">
                <tr>
                  <td style="padding: 20px; text-align: center;">
                    <p style="color: #4A5568; font-size: 14px; margin: 0 0 15px;">
                      Descubre más recursos en nuestra plataforma
                    </p>
                    <a href="https://prodominicana.gob.do/mujer-exporta" style="color: #F2665E; font-size: 14px; font-weight: 600; text-decoration: none;">
                      Explorar Mujer Exporta+ →
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #1A365D; padding: 30px 40px; text-align: center;">
              <img src="https://prodominicana.gob.do/svg/logos/Prodominicana.svg" alt="ProDominicana" width="160" style="max-width: 160px; height: auto; margin-bottom: 15px;">

              <p style="color: #CBD5E0; font-size: 13px; line-height: 1.6; margin: 0 0 10px;">
                Centro de Exportación e Inversión de la República Dominicana
              </p>
              <p style="color: #A0AEC0; font-size: 12px; line-height: 1.5; margin: 0 0 15px;">
                Av. 27 de Febrero esq. Av. Gregorio Luperón<br>
                Santo Domingo, República Dominicana
              </p>

              <!-- Social links -->
              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 20px;">
                <tr>
                  <td style="padding: 0 8px;">
                    <a href="https://www.facebook.com/ProDominicana">
                      <img src="https://sinim.prodominicana.gob.do/images/social/facebook.png" alt="Facebook" width="24" style="border-radius: 50%;">
                    </a>
                  </td>
                  <td style="padding: 0 8px;">
                    <a href="https://www.instagram.com/ProDominicana">
                      <img src="https://sinim.prodominicana.gob.do/images/social/instagram.png" alt="Instagram" width="24" style="border-radius: 50%;">
                    </a>
                  </td>
                  <td style="padding: 0 8px;">
                    <a href="https://www.linkedin.com/company/ceird/">
                      <img src="https://sinim.prodominicana.gob.do/images/social/linkedin.png" alt="LinkedIn" width="24" style="border-radius: 50%;">
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Unsubscribe link -->
              <p style="color: #718096; font-size: 11px; margin: 0 0 10px; border-top: 1px solid #2D3748; padding-top: 20px;">
                ¿No deseas recibir más correos de Mujer Exporta+?
              </p>
              <a href="{{unsubscribeUrl}}" style="color: #A0AEC0; font-size: 11px; text-decoration: underline;">
                Cancelar suscripción
              </a>

              <p style="color: #4A5568; font-size: 10px; margin: 15px 0 0;">
                © {{year}} ProDominicana. Todos los derechos reservados.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
